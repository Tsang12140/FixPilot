# 复制此文件为 .env 并填入你的 DeepSeek API Key
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 转写文件路径（相对项目根目录）
TRANSCRIPT_PATH=file/2025全球最全电脑故障解决指南(720P).txt

# 管理员账号（首次启动自动创建）
ADMIN_USERNAME=choose-an-admin-name
ADMIN_PASSWORD=choose-a-strong-unique-password

# token 签名密钥（生产环境务必改成随机长字符串）
FIXPILOT_TOKEN_SECRET=change-me-to-a-random-secret